# Notion internal integration token: https://www.notion.so/my-integrations
# Remember to "Share" your Notion page(s) with the integration or this will 403.
NOTION_API_KEY=secret_...

# Comma-separated Notion page IDs or URLs to sync, e.g. your "DW" page and any future ones.
NOTION_PAGE_IDS=3a9cd39eea64802a9b2dfe50e778a117

# Same Postgres connection string used by web/.env
DATABASE_URL=postgresql://user:password@host:5432/flashcart

# The FastAPI AI service
AI_SERVICE_URL=http://localhost:8000
