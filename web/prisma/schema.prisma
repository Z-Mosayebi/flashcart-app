// Flashcard — German Learning Flashcards with Leitner + AI Tutoring
// Prisma schema for Postgres (Neon/Supabase on Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  // Null for OAuth-only accounts; bcrypt hash for credentials sign-in.
  passwordHash  String?
  // Interface language ("en" | "de"). Card content is always German.
  locale        String    @default("en")
  createdAt     DateTime  @default(now())

  // Set once the starter deck has been copied in, so provisioning runs once.
  deckProvisionedAt DateTime?

  // Premium lasts until this instant; null or past means the free plan.
  // Nothing needs to run at expiry — the date passing is the expiry.
  premiumUntil DateTime?

  // IANA zone reported by the browser; daily limits and the streak reset at
  // its midnight. Null until the browser has reported one.
  timeZone String?

  // Set when an admin blocks the account: sign-in is refused and any open
  // session stops working on its next request. Null means active.
  blockedAt DateTime?

  accounts         Account[]
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  progress         CardProgress[]
  attempts         Attempt[]
  tutorSessions    TutorSession[]
  topics           Topic[]
  cards            Card[]
  sourceDocuments  SourceDocument[]
  driveConnection  DriveConnection?
  premiumRequests  PremiumRequest[]
  aiUsage          AiUsage[]
}

// ---------- NextAuth ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Password reset ----------

// A single-use password reset grant. Only the SHA-256 hash of the token is
// stored: the raw value lives solely in the emailed link, so a database leak
// can't be replayed to take over accounts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  // Set the moment the token is spent, so a link can't be replayed even
  // before it expires.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Source content ----------

// Where a document came from. NOTION is retained only so documents imported
// before the move to Drive keep their provenance; nothing creates new ones.
// UPLOAD is a file sent from the learner's computer; its externalId is the
// SHA-256 of the bytes, so the same file always maps to the same document.
enum SourceProvider {
  GOOGLE_DRIVE
  NOTION
  UPLOAD
}

// How far along an import is. Importing a long document takes minutes and
// several model calls, so the state is persisted rather than held in memory:
// the learner can close the app, and a restarted web tier can resume.
enum ImportStatus {
  PENDING
  IMPORTING
  COMPLETE
  FAILED
}

// One imported document, owned by the user who selected it. Keeps a raw
// snapshot plus revision metadata so a re-import can skip unchanged documents.
model SourceDocument {
  id          String         @id @default(cuid())
  provider    SourceProvider @default(GOOGLE_DRIVE)
  // Drive file id, or the Notion page id for pre-migration documents.
  externalId  String
  title       String
  rawMarkdown String         @db.Text
  // Drive's mimeType, so a re-import knows whether to extract prose or rows.
  mimeType    String?

  lastSyncedAt DateTime @default(now())

  // Change detection. Drive gives both a modified timestamp and an opaque
  // revision id; the revision id is authoritative because a file's timestamp
  // can move without its content changing.
  lastEditedTime DateTime?
  revisionId     String?

  status      ImportStatus @default(PENDING)
  // Sections completed / found, so progress is specific rather than a spinner.
  sectionsDone  Int     @default(0)
  sectionsTotal Int     @default(0)
  lastError     String? @db.Text

  // Set when the learner removes the document. The row stays so it keeps
  // counting toward the plan's document allowance (removing must not make room
  // while its cards remain), and re-importing the same file revives it.
  removedAt DateTime?

  // Null only for the shared starter template (see Topic.isTemplate).
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  topics Topic[]

  // The same document imported by two users must produce two independent
  // records, so uniqueness is per (owner, provider, document) not global.
  @@unique([ownerId, provider, externalId])
  @@index([ownerId])
  @@index([status])
}

// A user's Google Drive authorization, granted during sign-in rather than by a
// separate connect step.
//
// Only the refresh token is stored, encrypted at rest (AES-256-GCM, see
// web/lib/crypto.ts): it grants read access to the user's Drive, so it must
// never be stored in plaintext. Access tokens are short-lived, derived from it
// server-side on demand, and deliberately not persisted — a stolen row should
// not hand over a ready-to-use credential.
model DriveConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  encryptedRefreshToken String   @db.Text
  // The scopes actually granted. Consent screens let users withhold scopes, so
  // this records what was given rather than what was asked for.
  scopes                String[] @default([])

  lastSyncedAt DateTime?
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A grammar topic / pattern extracted from the notes, e.g. "weswegen relative clause",
// "aus + Dativ ... werden", "Anbindung an + Akkusativ"
//
// Topics are per-user. The one exception is the starter template
// (isTemplate = true, ownerId = null), which is never reviewed directly — it is
// copied into each new account at signup so everyone begins with content.
model Topic {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  pattern     String?  @db.Text // formula, e.g. "der Grund/die Gründe + , weswegen + ... + Verb(end)"
  language    String   @default("de")
  createdAt   DateTime @default(now())

  ownerId    String?
  owner      User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isTemplate Boolean @default(false)

  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  cards         Card[]
  tutorSessions TutorSession[]

  // One topic of a given name per user; the template set is keyed by null owner.
  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([isTemplate])
}

enum CardType {
  CLOZE // fill-in-the-blank, e.g. vocab-in-context
  SENTENCE_PRODUCTION // "build a sentence using this pattern"
  GRAMMAR_QA // toggle-style Q/A from notes
  ERROR_CORRECTION // "fix the mistake" cards, sourced from the error log
  VOCAB // simple term <-> meaning
}

// Cards are per-user, mirroring Topic. Template cards (isTemplate = true,
// ownerId = null) are the starter deck copied into each new account.
model Card {
  id          String   @id @default(cuid())
  type        CardType
  prompt      String   @db.Text // question / cloze text / instruction
  answer      String   @db.Text // expected answer or reference sentence
  explanation String?  @db.Text // grammar explanation shown after answering
  hints       String[] @default([])
  sourceText  String?  @db.Text // original sentence/snippet this card was generated from
  createdAt   DateTime @default(now())
  aiGenerated Boolean  @default(true)

  ownerId    String?
  owner      User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isTemplate Boolean @default(false)

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  progress CardProgress[]
  attempts Attempt[]

  @@index([topicId])
  @@index([ownerId])
  @@index([isTemplate])
}

// ---------- Leitner spaced repetition ----------

model CardProgress {
  id          String   @id @default(cuid())
  userId      String
  cardId      String
  box         Int      @default(1) // Leitner box 1-5
  dueAt       DateTime @default(now())
  lastReviewedAt DateTime?
  correctStreak  Int    @default(0)
  totalReviews   Int    @default(0)
  totalCorrect   Int    @default(0)
  aiDifficulty   Float  @default(0.5) // 0 (easy) - 1 (hard), blended into scheduling

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueAt])
}

enum AttemptResult {
  CORRECT
  PARTIAL
  INCORRECT
}

model Attempt {
  id         String        @id @default(cuid())
  userId     String
  cardId     String
  userAnswer String        @db.Text
  result     AttemptResult
  aiFeedback String?       @db.Text // AI's explanation of what was wrong/right
  errorTags  String[]      @default([]) // e.g. ["word-order", "case-declension"]
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- Conversational tutor sessions ----------

model TutorSession {
  id        String    @id @default(cuid())
  userId    String
  topicId   String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  mastered  Boolean   @default(false) // set when the tutor declares the pattern mastered
  summary   String?   @db.Text // AI-written summary of what was covered / mastered

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic    Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages TutorMessage[]

  @@index([userId, startedAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

model TutorMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  session TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ---------- Premium trial requests ----------

enum PremiumRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LearningGoal {
  EXAM
  WORK
  IMMIGRATION
  STUDY
  PERSONAL
  OTHER
}

enum GermanLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  UNKNOWN
}

// What the learner says they would pay per month, in EUR. Demand research
// for pricing, not a commitment.
enum PayWillingness {
  NOTHING
  UNDER_5
  FROM_5_TO_10
  OVER_10
}

model PremiumRequest {
  id           String               @id @default(cuid())
  userId       String
  goal         LearningGoal
  level        GermanLevel
  willingToPay PayWillingness
  // Telegram handle or phone, optional. Personal data: shown only to admins.
  contact      String?
  message      String?              @db.Text
  status       PremiumRequestStatus @default(PENDING)
  grantedDays  Int?
  createdAt    DateTime             @default(now())
  decidedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

// ---------- Daily AI allowance ----------

enum UsageKind {
  GRADED
  TUTOR
}

// One row per model call counted against a daily allowance. Written *before*
// the call and deleted if it fails, so parallel requests can't slip past the
// limit (see web/lib/usage.ts).
model AiUsage {
  id        String    @id @default(cuid())
  userId    String
  kind      UsageKind
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}
