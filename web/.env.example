# Postgres connection string (Neon, Supabase, Railway, or local Postgres all work)
DATABASE_URL=postgresql://user:password@host:5432/flashcart

# URL of the Python AI service (see ai-service/README or run locally on :8000)
AI_SERVICE_URL=http://localhost:8000

# Single-user demo mode — id used across seed data, dashboard, review session.
# Replace with real auth (NextAuth, Clerk, etc.) if you want multi-user later.
DEMO_USER_ID=demo-user
