# Postgres connection string (Neon, Supabase, Railway, or local Postgres all work)
DATABASE_URL=postgresql://user:password@host:5432/flashcart

# URL of the Python AI service (see ai-service/ — runs on :8000 locally)
AI_SERVICE_URL=http://localhost:8000
# Shared secret used only by server-side calls to the AI service. Generate one
# with: openssl rand -base64 32. This must exactly match ai-service/.env.
AI_SERVICE_AUTH_TOKEN=

# --- Auth (required) ---
# Public URL of this app. Use http://localhost:3000 in development.
NEXTAUTH_URL=http://localhost:3000
# Signing secret for session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Encrypts users' Google refresh tokens at rest (AES-256-GCM).
# Generate separately from NEXTAUTH_SECRET:
#   openssl rand -base64 32
# Changing this makes stored Drive access unreadable — users would simply need
# to sign in with Google again.
ENCRYPTION_KEY=

# --- Password reset email (optional) ---
# Sends the "forgot password" link via Resend (resend.com — free tier covers
# 3,000 emails/month, no card needed). Sign up, create an API key, paste it here.
# Leave blank and reset links are printed to the server console instead, which
# is fine for local development but means nobody receives them in production.
RESEND_API_KEY=
# Sender address. Resend's shared onboarding@resend.dev works without setup and
# only delivers to your own signup address; verify a domain to email anyone else.
EMAIL_FROM="Flashcard <onboarding@resend.dev>"

# --- Google sign-in and Drive import ---
# One OAuth client covers both: signing in, and reading the user's notes from
# Google Drive. Users grant Drive access in the same consent screen they use to
# sign in, so there is no separate "connect" step.
#
# Setup at console.cloud.google.com:
#   1. APIs & Services -> Library -> enable "Google Drive API" and "Google Sheets API"
#   2. Credentials -> Create OAuth client ID -> Web application
#   3. Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
#   4. OAuth consent screen -> add the scope:
#        https://www.googleapis.com/auth/drive.readonly
#
# Google requires verification before an app using drive.readonly can serve the
# public. Until then, add yourself and testers under "Test users" on the consent
# screen — up to 100 accounts work fully with no verification. Verification is a
# property of this app, done once by whoever runs the deployment; users never do
# anything beyond clicking Allow.
#
# Leave both blank and the app still runs with email + password sign-in; Drive
# import is then unavailable and says so in Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
