# Postgres connection string (Neon, Supabase, Railway, or local Postgres all work)
DATABASE_URL=postgresql://user:password@host:5432/flashcart

# URL of the Python AI service (see ai-service/ — runs on :8000 locally)
AI_SERVICE_URL=http://localhost:8000

# --- Auth (required) ---
# Public URL of this app. Use http://localhost:3000 in development.
NEXTAUTH_URL=http://localhost:3000
# Signing secret for session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Encrypts users' Notion integration tokens at rest (AES-256-GCM).
# Generate separately from NEXTAUTH_SECRET:
#   openssl rand -base64 32
# Changing this makes existing stored Notion tokens unreadable — users would
# simply need to reconnect.
ENCRYPTION_KEY=

# --- Notion one-click connect (optional but recommended) ---
# Lets users connect Notion with a single button instead of creating and pasting
# an integration token. Create a PUBLIC integration at notion.so/my-integrations,
# then set its redirect URI to {NEXTAUTH_URL}/api/me/notion/oauth/callback
# Leave blank and users fall back to pasting a token manually.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# --- Google sign-in (optional) ---
# Leave both blank to offer email + password sign-in only. To enable Google,
# create an OAuth client at console.cloud.google.com and set the redirect URI
# to {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
