# Which model provider to use: "gemini" (default) or "anthropic".
LLM_PROVIDER=gemini

# --- Gemini (free tier, no credit card) ---
# Get a key at https://aistudio.google.com/apikey
# Free limits are roughly 15 requests/minute and 1500/day — plenty for personal use.
GEMINI_API_KEY=

# --- Anthropic (paid, best German quality) ---
# Only needed if LLM_PROVIDER=anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model.
# Defaults: gemini-flash-lite-latest / claude-haiku-4-5-20251001
# If a Gemini call fails with 429 and "limit: 0", that model isn't on your key's
# tier — the -latest aliases track whatever the free tier currently serves.
# LLM_MODEL=

# Comma-separated origins allowed to call this service.
ALLOWED_ORIGINS=http://localhost:3000
